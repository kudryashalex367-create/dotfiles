# Генерируется matugen из обоев (~/.local/bin/wall-colors).
# Ручные правки перезапишутся — правь этот шаблон.
# У mako НЕТ секции [default]: глобальные опции идут до первого [criteria],
# поэтому генерируем весь конфиг целиком, без include.

font=JetBrainsMono Nerd Font Bold 11
background-color=#1d2026cc
text-color=#e1e2eb
border-color=#abc7ff
border-size=2
border-radius=16
padding=14,18
margin=0
outer-margin=16
default-timeout=5000
layer=overlay
anchor=top-right

[urgency=high]
background-color=#93000aee
text-color=#ffdad6
border-color=#ffb4ab
default-timeout=0
