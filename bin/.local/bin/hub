#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

run_menu() {
    local target="$1"

    if [[ -x "$HOME/.local/bin/$target" ]]; then
        "$HOME/.local/bin/$target" || true
    elif [[ -x "$SCRIPT_DIR/$target" ]]; then
        "$SCRIPT_DIR/$target" || true
    elif command -v "$target" >/dev/null 2>&1; then
        "$target" || true
    elif [[ "$target" == "audio-menu" ]]; then
        if [[ -x "$HOME/.local/bin/audio-sink-menu" ]]; then
            "$HOME/.local/bin/audio-sink-menu" || true
        elif [[ -x "$SCRIPT_DIR/audio-sink-menu" ]]; then
            "$SCRIPT_DIR/audio-sink-menu" || true
        elif command -v audio-sink-menu >/dev/null 2>&1; then
            audio-sink-menu || true
        fi
    fi
}

main() {
    while true; do
        local choice
        choice=$(printf "%s\n" \
            "󰝚 Музыка и плееры" \
            "󰕾 Звук и микрофоны" \
            "󰤨 Сеть Wi-Fi" \
            "󰂯 Устройства Bluetooth" \
            "󰸉 Сменить обои" \
            "󰌌 Шпаргалка по хоткеям" \
            "󰐥 Питание и сессия" \
            | fuzzel -d -p "󱗼 Центр управления ❯ " -l 8 -w 32 || true)

        [[ -z "$choice" ]] && exit 0

        case "$choice" in
            "󰝚 Музыка и плееры")
                run_menu "media-menu"
                ;;
            "󰕾 Звук и микрофоны")
                run_menu "audio-menu"
                ;;
            "󰤨 Сеть Wi-Fi")
                run_menu "wifi-menu"
                ;;
            "󰂯 Устройства Bluetooth")
                run_menu "bluetooth-menu"
                ;;
            "󰸉 Сменить обои")
                run_menu "wall-picker"
                ;;
            "󰌌 Шпаргалка по хоткеям")
                run_menu "keybinds"
                ;;
            "󰐥 Питание и сессия")
                run_menu "powermenu"
                ;;
            *)
                exit 0
                ;;
        esac
    done
}

main "$@"
