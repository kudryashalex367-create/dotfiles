#!/usr/bin/env bash
# Управление звуковыми устройствами, микрофонами и громкостью через pactl/wpctl и fuzzel.
set -euo pipefail

get_default_sink() {
    local def
    def=$(pactl get-default-sink 2>/dev/null || true)
    if [[ -z "$def" ]]; then
        def=$(pactl info 2>/dev/null | awk -F': ' '/Default Sink:/{print $2}' || true)
    fi
    echo "$def"
}

get_default_source() {
    local def
    def=$(pactl get-default-source 2>/dev/null || true)
    if [[ -z "$def" ]]; then
        def=$(pactl info 2>/dev/null | awk -F': ' '/Default Source:/{print $2}' || true)
    fi
    echo "$def"
}

get_sink_volume_display() {
    local vol=""
    if command -v wpctl >/dev/null 2>&1; then
        vol=$(LC_ALL=C wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null \
            | awk '/Volume:/{ vol=int($2*100); if (/MUTED/) printf "%d%% [Mute]", vol; else printf "%d%%", vol }' || true)
    fi
    if [[ -z "$vol" ]] && command -v pactl >/dev/null 2>&1; then
        vol=$(LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | head -n1 | grep -oE '[0-9]+%' | head -n1 || true)
    fi
    echo "${vol:-100%}"
}

adjust_volume() {
    local delta="$1"
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ "$delta" 2>/dev/null || true
    elif command -v pactl >/dev/null 2>&1; then
        pactl set-sink-volume @DEFAULT_SINK@ "$delta" 2>/dev/null || true
    fi
}

toggle_sink_mute() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null || true
    elif command -v pactl >/dev/null 2>&1; then
        pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null || true
    fi
}

is_mic_muted() {
    if LC_ALL=C pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -qi "yes"; then
        return 0
    fi
    if LC_ALL=C wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -qi "MUTED"; then
        return 0
    fi
    return 1
}

toggle_mic() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle 2>/dev/null || pactl set-source-mute @DEFAULT_SOURCE@ toggle 2>/dev/null || true
    elif command -v pactl >/dev/null 2>&1; then
        pactl set-source-mute @DEFAULT_SOURCE@ toggle 2>/dev/null || true
    fi

    if is_mic_muted; then
        notify-send -a "Аудио" -i "microphone-sensitivity-muted" "(•_•) Микрофон выключен" "Звук отключён"
    else
        notify-send -a "Аудио" -i "audio-input-microphone" "(^_^)b Микрофон включён" "Звук включён"
    fi
}

select_sink() {
    local default_sink raw_list choice name desc
    default_sink="$(get_default_sink)"

    raw_list=$(pactl list sinks 2>/dev/null | awk -v def="$default_sink" '
        function flush_entry() {
            if (name != "") {
                mark = (name == def) ? "󰄬 " : "   "
                if (desc == "") desc = name
                printf "%s%s (%s)\n", mark, desc, name
            }
            name = ""
            desc = ""
        }
        /^[[:space:]]*Sink #[0-9]+/ {
            flush_entry()
        }
        /^[[:space:]]*Name:[[:space:]]*/ {
            sub(/^[[:space:]]*Name:[[:space:]]*/, "")
            name = $0
        }
        /^[[:space:]]*Description:[[:space:]]*/ {
            sub(/^[[:space:]]*Description:[[:space:]]*/, "")
            desc = $0
        }
        END {
            flush_entry()
        }
    ')

    if [[ -z "$raw_list" ]]; then
        notify-send -a "Аудио" "(>_<) Ошибка" "Устройства вывода не найдены"
        return
    fi

    choice=$(echo "$raw_list" | fuzzel -d -p "󰓃 Выход звука ❯ " -l 10 -w 50 || true)
    [[ -z "$choice" ]] && return

    name="${choice##* (}"
    name="${name%)}"

    desc="${choice% (*)}"
    desc="${desc#󰄬 }"
    desc="${desc#   }"

    pactl set-default-sink "$name" 2>/dev/null || true

    pactl list short sink-inputs 2>/dev/null | awk '{print $1}' | while read -r input_id; do
        [[ -n "$input_id" ]] && pactl move-sink-input "$input_id" "$name" 2>/dev/null || true
    done

    notify-send -a "Аудио" -i "audio-speakers" "(^_^)b Выход изменён" "$desc"
}

select_source() {
    local default_source raw_list choice name desc
    default_source="$(get_default_source)"

    raw_list=$(pactl list sources 2>/dev/null | awk -v def="$default_source" '
        function flush_entry() {
            if (name != "") {
                if (name !~ /\.monitor$/) {
                    mark = (name == def) ? "󰄬 " : "   "
                    if (desc == "") desc = name
                    printf "%s%s (%s)\n", mark, desc, name
                }
            }
            name = ""
            desc = ""
        }
        /^[[:space:]]*Source #[0-9]+/ {
            flush_entry()
        }
        /^[[:space:]]*Name:[[:space:]]*/ {
            sub(/^[[:space:]]*Name:[[:space:]]*/, "")
            name = $0
        }
        /^[[:space:]]*Description:[[:space:]]*/ {
            sub(/^[[:space:]]*Description:[[:space:]]*/, "")
            desc = $0
        }
        END {
            flush_entry()
        }
    ')

    if [[ -z "$raw_list" ]]; then
        notify-send -a "Аудио" "(>_<) Ошибка" "Микрофоны не найдены"
        return
    fi

    choice=$(echo "$raw_list" | fuzzel -d -p "󰍬 Вход звука ❯ " -l 10 -w 50 || true)
    [[ -z "$choice" ]] && return

    name="${choice##* (}"
    name="${name%)}"

    desc="${choice% (*)}"
    desc="${desc#󰄬 }"
    desc="${desc#   }"

    pactl set-default-source "$name" 2>/dev/null || true

    pactl list short source-outputs 2>/dev/null | awk '{print $1}' | while read -r output_id; do
        [[ -n "$output_id" ]] && pactl move-source-output "$output_id" "$name" 2>/dev/null || true
    done

    notify-send -a "Аудио" -i "audio-input-microphone" "(^_^)b Микрофон изменён" "$desc"
}

run_combine() {
    local script="$HOME/.local/bin/audio-combine"
    if [[ ! -x "$script" ]]; then
        if command -v audio-combine >/dev/null 2>&1; then
            script="$(command -v audio-combine)"
        else
            notify-send -a "Аудио" -u critical "(>_<) Ошибка" "Скрипт audio-combine не найден"
            return
        fi
    fi

    if pgrep -f "audio-combine" >/dev/null; then
        notify-send -a "Аудио" "(•_•) audio-combine" "Скрипт уже запущен"
    else
        nohup "$script" >/dev/null 2>&1 &
        notify-send -a "Аудио" "(^_^)b audio-combine" "Объединение устройств запущено"
    fi
}

main() {
    if ! command -v pactl >/dev/null 2>&1; then
        notify-send -a "Аудио" -u critical "(>_<) Ошибка" "pactl не установлен"
        exit 1
    fi

    while true; do
        local cur_vol mic_status mic_item action
        cur_vol="$(get_sink_volume_display)"

        if is_mic_muted; then
            mic_status="Выкл"
        else
            mic_status="Вкл"
        fi
        mic_item="󰍭 Переключить микрофон [${mic_status}]"

        local options=(
            "󰕾 Громкость +5%  (сейчас ${cur_vol})"
            "󰖀 Громкость -5%"
            "󰝟 Вкл/выкл звук динамиков (Mute)"
            "$mic_item"
            "󰓃 Выход звука (Динамики / Наушники)"
            "󰍬 Вход звука (Микрофоны)"
            "󱄠 Объединить аудиоустройства (audio-combine)"
            "󰅖 Закрыть"
        )

        action=$(printf '%s\n' "${options[@]}" | fuzzel -d -p "󰕾 Звук [${cur_vol}] ❯ " -l 9 -w 45 || true)
        [[ -z "$action" || "$action" == "󰅖 Закрыть" ]] && break

        case "$action" in
            *"Громкость +5%"*)
                adjust_volume "5%+"
                sleep 0.05
                ;;
            *"Громкость -5%"*)
                adjust_volume "5%-"
                sleep 0.05
                ;;
            *"Вкл/выкл звук динамиков"*)
                toggle_sink_mute
                sleep 0.05
                ;;
            "󰍭 Переключить микрофон"*)
                toggle_mic
                sleep 0.05
                ;;
            "󰓃 Выход звука (Динамики / Наушники)"*)
                select_sink
                ;;
            "󰍬 Вход звука (Микрофоны)"*)
                select_source
                ;;
            "󱄠 Объединить аудиоустройства"*)
                run_combine
                ;;
        esac
    done
}

main "$@"
