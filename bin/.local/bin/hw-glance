#!/usr/bin/env bash
# hw-glance — мгновенная прямая телеметрия APU и системы без демонов.
# Читает /sys/class/hwmon, /sys/class/drm и /proc/meminfo за 1-2 мс.
# Режимы:
#   hw-glance          — разовый вывод в терминал (или notify-send, если не в TTY)
#   hw-glance -n       — принудительно через notify-send (Mako)
#   hw-glance -w       — живой мониторинг в терминале (обновление раз в секунду)
set -euo pipefail

watch_mode=0
notify_mode=0

for arg in "$@"; do
    case "$arg" in
        -w|--watch) watch_mode=1 ;;
        -n|--notify) notify_mode=1 ;;
        -h|--help)
            echo "Использование: hw-glance [-w|--watch] [-n|--notify]"
            exit 0
            ;;
    esac
done

if [[ $notify_mode -eq 0 && ! -t 1 ]]; then
    notify_mode=1
fi

get_metrics() {
    local k10="" amd=""
    for h in /sys/class/hwmon/hwmon*; do
        [[ -f "$h/name" ]] || continue
        case "$(< "$h/name")" in
            k10temp) k10="$h" ;;
            amdgpu) amd="$h" ;;
        esac
    done

    # CPU temp (Ryzen 5600H)
    cpu_temp="N/A"
    if [[ -n "$k10" && -f "$k10/temp1_input" ]]; then
        cpu_temp=$(awk '{printf "%.1f", $1/1000}' "$k10/temp1_input")
    fi

    # CPU freq (средняя и максимальная по ядрам)
    cpu_avg_mhz="N/A"
    cpu_max_mhz="N/A"
    local freqs=()
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
        [[ -f "$f" ]] && freqs+=( "$(< "$f")" )
    done
    if [[ ${#freqs[@]} -gt 0 ]]; then
        local sum=0 max=0
        for val in "${freqs[@]}"; do
            (( sum += val ))
            (( val > max )) && max=$val
        done
        cpu_avg_mhz=$(( sum / ${#freqs[@]} / 1000 ))
        cpu_max_mhz=$(( max / 1000 ))
    fi

    # GPU (Vega 7)
    gpu_busy="0"
    if [[ -n "$amd" && -f "$amd/device/gpu_busy_percent" ]]; then
        gpu_busy=$(< "$amd/device/gpu_busy_percent")
    elif [[ -f /sys/class/drm/card0/device/gpu_busy_percent ]]; then
        gpu_busy=$(< /sys/class/drm/card0/device/gpu_busy_percent)
    fi

    gpu_mhz="0"
    if [[ -n "$amd" && -f "$amd/freq1_input" ]]; then
        gpu_mhz=$(awk '{printf "%d", $1/1000000}' "$amd/freq1_input")
    fi

    gpu_pwr="0.0"
    if [[ -n "$amd" && -f "$amd/power1_input" ]]; then
        gpu_pwr=$(awk '{printf "%.1f", $1/1000000}' "$amd/power1_input")
    elif [[ -n "$amd" && -f "$amd/power1_average" ]]; then
        gpu_pwr=$(awk '{printf "%.1f", $1/1000000}' "$amd/power1_average")
    fi

    # RAM & Swap
    local mt=0 ma=0 st=0 sf=0
    while read -r key val _; do
        case "$key" in
            MemTotal:) mt=$val ;;
            MemAvailable:) ma=$val ;;
            SwapTotal:) st=$val ;;
            SwapFree:) sf=$val ;;
        esac
    done < /proc/meminfo

    mem_used=$(awk -v t="$mt" -v a="$ma" 'BEGIN{printf "%.1fG / %.1fG", (t-a)/1048576, t/1048576}')
    swap_used=$(awk -v t="$st" -v f="$sf" 'BEGIN{printf "%.1fG", (t-f)/1048576}')
}

render_notify() {
    get_metrics
    notify-send -a "hw-glance" -i "utilities-system-monitor" \
        "⚡ APU & Zen 3 [144Hz]" \
        " CPU:  ${cpu_temp}°C @ ${cpu_avg_mhz}MHz (макс ${cpu_max_mhz}MHz)
󰢮 GPU:  ${gpu_busy}% | ${gpu_mhz}MHz | ${gpu_pwr}W
󰍛 RAM:  ${mem_used} (Swap: ${swap_used})"
}

render_terminal() {
    get_metrics
    printf "\033[1;35mʕ•ᴥ•ʔ\033[0m \033[1;37mАппаратная телеметрия APU [144Hz]\033[0m\n"
    printf "\033[0;34m──────────────────────────────────────────────\033[0m\n"
    printf "  \033[1;36m CPU (Ryzen 5 5600H):\033[0m  %s°C  |  %s MHz (пик %s MHz)\n" "$cpu_temp" "$cpu_avg_mhz" "$cpu_max_mhz"
    printf "  \033[1;35m󰢮 GPU (Radeon Vega 7):\033[0m  %s MHz |  Загрузка: %s%%  |  %sW\n" "$gpu_mhz" "$gpu_busy" "$gpu_pwr"
    printf "  \033[1;32m󰍛 RAM (Память):\033[0m        %s  |  Swap: %s\n" "$mem_used" "$swap_used"
    printf "\033[0;34m──────────────────────────────────────────────\033[0m\n"
}

if [[ $notify_mode -eq 1 ]]; then
    render_notify
    exit 0
fi

if [[ $watch_mode -eq 1 ]]; then
    trap 'tput cnorm; exit 0' INT TERM
    tput civis
    while true; do
        clear
        render_terminal
        printf "\033[0;90mНажмите Ctrl+C для выхода\033[0m\n"
        sleep 1
    done
else
    render_terminal
fi
