#!/usr/bin/env bash
# Меню управления Wi-Fi через NetworkManager (nmcli) и fuzzel.
set -euo pipefail

command -v nmcli >/dev/null 2>&1 || {
    notify-send -u critical -a "Wi-Fi" "(>_<) Ошибка" "nmcli не найден"
    exit 1
}
command -v fuzzel >/dev/null 2>&1 || {
    notify-send -u critical -a "Wi-Fi" "(>_<) Ошибка" "fuzzel не найден"
    exit 1
}

get_signal_icon() {
    local sig="${1:-0}"
    if (( sig >= 80 )); then
        echo "󰤨"
    elif (( sig >= 60 )); then
        echo "󰤥"
    elif (( sig >= 40 )); then
        echo "󰤢"
    elif (( sig >= 20 )); then
        echo "󰤟"
    else
        echo "󰤯"
    fi
}

is_open_network() {
    local sec="$1"
    if [[ -z "$sec" || "$sec" == "--" ]]; then
        return 0
    fi
    if [[ "$sec" != *WPA* && "$sec" != *WEP* && "$sec" != *802.1X* && "$sec" != *wpa* ]]; then
        return 0
    fi
    return 1
}

is_known_network() {
    local target_ssid="$1"
    if nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$target_ssid"; then
        return 0
    fi
    if nmcli -t -f 802-11-wireless.ssid connection show 2>/dev/null | grep -Fxq "$target_ssid"; then
        return 0
    fi
    return 1
}

connect_with_password() {
    local ssid="$1"
    local password

    # Окно ввода пароля: видимый ввод (без скрытия звездочками) и понятный placeholder
    password=$(fuzzel -d --prompt-only="Пароль для $ssid ❯ " --placeholder="Введите пароль..." -w 42 || true)
    [[ -z "$password" ]] && return 0

    notify-send -a "Wi-Fi" "(o_o) Подключение" "Подключение к «$ssid»..."

    # Удаляем старый профиль, если он существовал с неверным паролем
    nmcli connection delete id "$ssid" >/dev/null 2>&1 || true

    local output
    if output=$(nmcli dev wifi connect "$ssid" password "$password" 2>&1); then
        notify-send -a "Wi-Fi" -i "network-wireless" "(^_^)b Подключено" "Подключено к «$ssid»"
    else
        notify-send -u critical -a "Wi-Fi" "(>_<) Ошибка подключения" "$output"
    fi
}

show_active_network_menu() {
    local ssid="$1"
    local action
    action=$(printf '%s\n' \
        "󰅖 Отключиться" \
        "󰑐 Переподключиться" \
        "󰆴 Забыть сеть (удалить)" \
        "󰌍 Назад" \
        | fuzzel -d -p "Сеть $ssid ❯ " -l 4 -w 32 || true)

    case "$action" in
        "󰅖 Отключиться")
            nmcli connection down "$ssid" 2>/dev/null || true
            notify-send -a "Wi-Fi" "(•_•) Отключено" "Отключено от «$ssid»"
            ;;
        "󰑐 Переподключиться")
            notify-send -a "Wi-Fi" "(o_o) Переподключение" "Переподключение к «$ssid»..."
            nmcli connection up "$ssid" 2>/dev/null || true
            ;;
        "󰆴 Забыть сеть (удалить)")
            nmcli connection delete id "$ssid" 2>/dev/null || true
            notify-send -a "Wi-Fi" "(•_•) Сеть удалена" "Сеть «$ssid» удалена"
            ;;
        *)
            ;;
    esac
}

main() {
    local wifi_state
    wifi_state=$(LC_ALL=C nmcli radio wifi 2>/dev/null || echo "disabled")

    local menu=()
    declare -A net_ssid net_security net_is_active

    if [[ "$wifi_state" == "enabled" ]]; then
        menu+=("󰑐 Обновить список сетей")
        menu+=("󰤮 Выключить Wi-Fi")

        # Считываем доступные сети
        declare -A seen_ssid best_signal best_security best_inuse
        local order=()

        while IFS=: read -r in_use signal security ssid; do
            [[ -z "$ssid" || "$ssid" == "--" ]] && continue

            if [[ -z "${seen_ssid[$ssid]:-}" ]]; then
                seen_ssid["$ssid"]=1
                order+=("$ssid")
                best_signal["$ssid"]="${signal:-0}"
                best_security["$ssid"]="$security"
                best_inuse["$ssid"]="$in_use"
            else
                if [[ "$in_use" == "*" ]]; then
                    best_inuse["$ssid"]="*"
                fi
                if (( ${signal:-0} > ${best_signal[$ssid]:-0} )); then
                    best_signal["$ssid"]="${signal:-0}"
                    best_security["$ssid"]="$security"
                fi
            fi
        done < <(nmcli -t -e no -f "IN-USE,SIGNAL,SECURITY,SSID" device wifi list 2>/dev/null || true)

        local active_ssids=()
        local other_ssids=()
        for s in "${order[@]}"; do
            if [[ "${best_inuse[$s]:-}" == "*" ]]; then
                active_ssids+=("$s")
            else
                other_ssids+=("$s")
            fi
        done

        local sorted_order=()
        for s in "${active_ssids[@]}"; do
            sorted_order+=("$s")
        done
        for s in "${other_ssids[@]}"; do
            sorted_order+=("$s")
        done

        for s in "${sorted_order[@]}"; do
            local sig="${best_signal[$s]:-0}"
            local sec="${best_security[$s]:-}"
            local inuse="${best_inuse[$s]:-}"

            local conn_mark="  "
            local is_act=0
            if [[ "$inuse" == "*" ]]; then
                conn_mark="󰄬 "
                is_act=1
            fi

            local sig_icon
            sig_icon=$(get_signal_icon "$sig")

            local sec_label
            if is_open_network "$sec"; then
                sec_label="Открытая"
            else
                sec_label="$sec"
            fi

            local item="${conn_mark}${sig_icon}  ${s}  (${sig}%, ${sec_label})"
            menu+=("$item")
            net_ssid["$item"]="$s"
            net_security["$item"]="$sec"
            net_is_active["$item"]="$is_act"
        done
    else
        menu+=("󰤨 Включить Wi-Fi")
    fi

    local choice
    choice=$(printf '%s\n' "${menu[@]}" | fuzzel -d -p "󰤨 Wi-Fi ❯ " -w 45 -l 12 || true)
    [[ -z "$choice" ]] && exit 0

    case "$choice" in
        "󰑐 Обновить список сетей")
            nmcli dev wifi rescan 2>/dev/null || true
            exec "$0"
            ;;
        "󰤮 Выключить Wi-Fi")
            nmcli radio wifi off
            notify-send -a "Wi-Fi" "(•_•) Wi-Fi" "Wi-Fi выключен"
            exit 0
            ;;
        "󰤨 Включить Wi-Fi")
            nmcli radio wifi on
            notify-send -a "Wi-Fi" "(^_^)b Wi-Fi" "Wi-Fi включён"
            exit 0
            ;;
    esac

    local ssid="${net_ssid["$choice"]:-}"
    [[ -z "$ssid" ]] && exit 0
    local security="${net_security["$choice"]:-}"
    local is_act="${net_is_active["$choice"]:-0}"

    # Если уже подключены к этой сети — открываем меню управления
    if (( is_act )); then
        show_active_network_menu "$ssid"
        exit 0
    fi

    # Если сеть открытая — подключаемся сразу
    if is_open_network "$security"; then
        notify-send -a "Wi-Fi" "(o_o) Подключение" "Подключение к открытой сети «$ssid»..."
        local output
        if output=$(nmcli dev wifi connect "$ssid" 2>&1); then
            notify-send -a "Wi-Fi" -i "network-wireless" "(^_^)b Подключено" "Подключено к «$ssid»"
        else
            notify-send -u critical -a "Wi-Fi" "(>_<) Ошибка подключения" "$output"
        fi
        exit 0
    fi

    # Если сеть известна, пробуем быстрое подключение
    if is_known_network "$ssid"; then
        notify-send -a "Wi-Fi" "(o_o) Подключение" "Подключение к «$ssid»..."
        local output
        if output=$(nmcli connection up "$ssid" 2>&1 || nmcli dev wifi connect "$ssid" 2>&1); then
            notify-send -a "Wi-Fi" -i "network-wireless" "(^_^)b Подключено" "Подключено к «$ssid»"
            exit 0
        fi
        # Если сохранённый пароль не сработал — уведомляем и запрашиваем пароль
        notify-send -a "Wi-Fi" "(>_<) Ошибка" "Сохранённое подключение не удалось. Введите пароль."
    fi

    # Запрашиваем пароль для новой или не подключившейся сети
    connect_with_password "$ssid"
}

main "$@"
