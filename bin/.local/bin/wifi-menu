#!/usr/bin/env bash
# Меню управления Wi-Fi через NetworkManager (nmcli) и fuzzel.
set -euo pipefail

command -v nmcli >/dev/null 2>&1 || {
    notify-send -u critical -a "Wi-Fi" "Wi-Fi" "nmcli не найден"
    exit 1
}
command -v fuzzel >/dev/null 2>&1 || {
    notify-send -u critical -a "Wi-Fi" "Wi-Fi" "fuzzel не найден"
    exit 1
}

# Проверяем статус адаптера Wi-Fi
wifi_state=$(LC_ALL=C nmcli radio wifi 2>/dev/null || echo "disabled")

get_signal_icon() {
    local sig="${1:-0}"
    if (( sig >= 80 )); then
        echo "󰤨"
    elif (( sig >= 60 )); then
        echo "󰤥"
    elif (( sig >= 40 )); then
        echo "󰤢"
    elif (( sig >= 20 )); then
        echo "󰤟"
    else
        echo "󰤯"
    fi
}

is_open_network() {
    local sec="$1"
    if [[ -z "$sec" || "$sec" == "--" ]]; then
        return 0
    fi
    if [[ "$sec" != *WPA* && "$sec" != *WEP* && "$sec" != *802.1X* && "$sec" != *wpa* ]]; then
        return 0
    fi
    return 1
}

is_known_network() {
    local target_ssid="$1"
    if nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$target_ssid"; then
        return 0
    fi
    if nmcli -t -f 802-11-wireless.ssid connection show 2>/dev/null | grep -Fxq "$target_ssid"; then
        return 0
    fi
    return 1
}

menu=()
declare -A net_ssid net_security

if [[ "$wifi_state" == "enabled" ]]; then
    menu+=("󰤮 Выключить Wi-Fi")

    # Считываем доступные сети
    declare -A seen_ssid best_signal best_security best_inuse
    order=()

    while IFS=: read -r in_use signal security ssid; do
        [[ -z "$ssid" || "$ssid" == "--" ]] && continue

        if [[ -z "${seen_ssid[$ssid]:-}" ]]; then
            seen_ssid["$ssid"]=1
            order+=("$ssid")
            best_signal["$ssid"]="${signal:-0}"
            best_security["$ssid"]="$security"
            best_inuse["$ssid"]="$in_use"
        else
            if [[ "$in_use" == "*" ]]; then
                best_inuse["$ssid"]="*"
            fi
            if (( ${signal:-0} > ${best_signal[$ssid]:-0} )); then
                best_signal["$ssid"]="${signal:-0}"
                best_security["$ssid"]="$security"
            fi
        fi
    done < <(nmcli -t -e no -f "IN-USE,SIGNAL,SECURITY,SSID" device wifi list 2>/dev/null || true)

    # Разделяем на активные (подключенные) и остальные
    active_ssids=()
    other_ssids=()
    for s in "${order[@]}"; do
        if [[ "${best_inuse[$s]:-}" == "*" ]]; then
            active_ssids+=("$s")
        else
            other_ssids+=("$s")
        fi
    done

    sorted_order=()
    for s in "${active_ssids[@]}"; do
        sorted_order+=("$s")
    done
    for s in "${other_ssids[@]}"; do
        sorted_order+=("$s")
    done

    for s in "${sorted_order[@]}"; do
        sig="${best_signal[$s]:-0}"
        sec="${best_security[$s]:-}"
        inuse="${best_inuse[$s]:-}"

        conn_mark="  "
        if [[ "$inuse" == "*" ]]; then
            conn_mark="󰄬 "
        fi

        sig_icon=$(get_signal_icon "$sig")

        if is_open_network "$sec"; then
            sec_label="Open"
        else
            sec_label="$sec"
        fi

        item="${conn_mark}${sig_icon}  ${s}  (${sig}%, ${sec_label})"
        menu+=("$item")
        net_ssid["$item"]="$s"
        net_security["$item"]="$sec"
    done
else
    menu+=("󰤨 Включить Wi-Fi")
fi

choice=$(printf '%s\n' "${menu[@]}" | fuzzel -d -p "󰤨 Wi-Fi ❯ " || true)
[ -z "$choice" ] && exit 0

case "$choice" in
    "󰤮 Выключить Wi-Fi")
        nmcli radio wifi off
        notify-send -a "Wi-Fi" "Wi-Fi" "Wi-Fi выключен"
        exit 0
        ;;
    "󰤨 Включить Wi-Fi")
        nmcli radio wifi on
        notify-send -a "Wi-Fi" "Wi-Fi" "Wi-Fi включён"
        exit 0
        ;;
esac

ssid="${net_ssid["$choice"]:-}"
[ -z "$ssid" ] && exit 0
security="${net_security["$choice"]:-}"

if is_known_network "$ssid" || is_open_network "$security"; then
    notify-send -a "Wi-Fi" "Wi-Fi" "Подключение к «$ssid»..."
    if output=$(nmcli dev wifi connect "$ssid" 2>&1); then
        notify-send -a "Wi-Fi" "Wi-Fi" "Подключено к «$ssid»"
        exit 0
    fi

    if is_open_network "$security"; then
        notify-send -u critical -a "Wi-Fi" "Ошибка подключения" "$output"
        exit 1
    fi
fi

password=$(fuzzel -d -p "Пароль для $ssid ❯ " --password -w 30 </dev/null || true)
[ -z "$password" ] && exit 0

notify-send -a "Wi-Fi" "Wi-Fi" "Подключение к «$ssid»..."
if output=$(nmcli dev wifi connect "$ssid" password "$password" 2>&1); then
    notify-send -a "Wi-Fi" "Wi-Fi" "Подключено к «$ssid»"
else
    notify-send -u critical -a "Wi-Fi" "Ошибка подключения" "$output"
fi
