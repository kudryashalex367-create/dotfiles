#!/usr/bin/env bash
# Проверка квот в Antigravity CLI (agy) с выводом в Mako.
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

# Доступ к D-Bus при вызове с хоткея композитора
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    _rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${_rt}/bus"
fi

# Прокси для agy (как в agy-dots из .zshrc, независимо от скрипта proxy)
export http_proxy="http://127.0.0.1:10809"
export https_proxy="http://127.0.0.1:10809"
export HTTP_PROXY="http://127.0.0.1:10809"
export HTTPS_PROXY="http://127.0.0.1:10809"

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "agy" \
        -h string:x-canonical-private-synchronous:agy-limits \
        "$@" 2>/dev/null || true
}

debug=0
[[ "${1:-}" == "--debug" ]] && debug=1

if ! command -v agy >/dev/null 2>&1; then
    notify -u critical "(>_<) Ошибка" "Бинарник agy не найден в PATH"
    exit 1
fi

(( debug == 0 )) && notify "(o_o) Лимиты AGY" "Запрашиваю квоты..."

# Запрос квот через официальный неинтерактивный print-mode agy (-p "/usage")
raw_output=""
raw_output=$(agy --output-format json -p "/usage" 2>/dev/null || true)
if [[ -z "$raw_output" ]]; then
    raw_output=$(agy -p "/usage" 2>/dev/null || true)
fi

if (( debug == 1 )); then
    echo "--- RAW OUTPUT ---"
    printf '%s\n' "$raw_output"
    echo "--- PARSED ---"
fi

limits=$(RAW_DATA="$raw_output" python3 - <<'PY'
import os, sys, json, re
from datetime import datetime, timezone

raw = os.environ.get("RAW_DATA", "").strip()
if not raw:
    sys.exit(0)

out = []

# 1. Попытка распарсить как JSON
try:
    doc = json.loads(raw, strict=False)
    if doc.get("status") == "ERROR" and doc.get("error"):
        err = doc["error"].strip()
        if "PERMISSION_DENIED" in err or "location" in err.lower():
            print("ERROR:Нет доступа (403 location) — проверь прокси")
        else:
            print(f"ERROR:{err[:160]}")
        sys.exit(0)
    groups = doc.get("command", {}).get("data", {}).get("groups", [])
    if groups:
        for g in groups:
            g_name = g.get("name", "Models")
            if "gemini" in g_name.lower():
                g_label = "Gemini"
            elif "claude" in g_name.lower():
                g_label = "Claude & GPT"
            else:
                g_label = g_name

            buckets = g.get("buckets", [])
            # Сортируем: 5-Hour сначала, затем Weekly
            buckets.sort(key=lambda b: 0 if (b.get("window") == "5h" or "five" in b.get("name", "").lower()) else 1)

            lines = []
            for b in buckets:
                b_name = b.get("name", "")
                frac = b.get("remaining_fraction")
                pct = f"{int(round(frac * 100))}%" if frac is not None else "?%"

                w = b.get("window", "")
                if w == "5h" or "five hour" in b_name.lower():
                    label = "5-Hour"
                elif w == "weekly" or "weekly" in b_name.lower():
                    label = "Weekly"
                else:
                    label = b_name

                rt_str = b.get("reset_time", "")
                time_hint = ""
                if rt_str:
                    try:
                        dt = datetime.fromisoformat(rt_str.replace("Z", "+00:00")).astimezone()
                        now = datetime.now(timezone.utc).astimezone()
                        if dt.date() == now.date():
                            time_hint = f"до {dt.strftime('%H:%M')}"
                        else:
                            time_hint = f"до {dt.strftime('%d.%m %H:%M')}"
                    except Exception:
                        pass

                if time_hint:
                    lines.append(f"  • {label}: {pct} ({time_hint})")
                else:
                    lines.append(f"  • {label}: {pct}")

            if lines:
                out.append(f"{g_label}:")
                out.extend(lines)

        if out:
            print("\n".join(out))
            sys.exit(0)
except Exception:
    pass

# 2. Фолбэк на разбор текстового вывода agy -p "/usage"
groups_dict = {}
for ln in raw.splitlines():
    ln = ln.strip()
    if not ln or ln.lower().startswith("quota:"):
        continue
    m = re.match(r"^(.*?)\s{2,}(Weekly Limit Remaining|Five Hour Limit Remaining)\s+(\d+%)\s+(.*)$", ln, re.I)
    if m:
        grp, win, pct, rst = m.groups()
        g_label = "Gemini" if "gemini" in grp.lower() else ("Claude & GPT" if "claude" in grp.lower() else grp)
        w_label = "5-Hour" if "five" in win.lower() else "Weekly"
        time_part = rst.strip()
        groups_dict.setdefault(g_label, []).append((w_label, pct, time_part))
    else:
        parts = [p.strip() for p in ln.split("\t") if p.strip()]
        if len(parts) >= 3:
            out.append("  ".join(parts[:3]))

if groups_dict:
    for g_label, b_list in groups_dict.items():
        out.append(f"{g_label}:")
        b_list.sort(key=lambda x: 0 if x[0] == "5-Hour" else 1)
        for w_label, pct, rst in b_list:
            out.append(f"  • {w_label}: {pct} (до {rst})")

if out:
    print("\n".join(out))
PY
)

if (( debug == 1 )); then
    printf '%s\n' "$limits"
    exit 0
fi

if [[ -z "$limits" ]]; then
    notify -u critical "(>_<) Лимиты AGY" "Не удалось получить квоты (agy-limits --debug)"
    exit 1
fi

if [[ "$limits" == ERROR:* ]]; then
    notify -u critical "(>_<) Лимиты AGY" "${limits#ERROR:}"
    exit 1
fi

notify "(⌐■_■) Лимиты AGY:" "$limits"
