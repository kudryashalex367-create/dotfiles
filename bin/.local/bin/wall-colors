#!/usr/bin/env bash
# Пайплайн палитры из обоев.
# Использование:
#   wall-colors <image>              — поставить обои + перегенерировать палитру
#   wall-colors --colors-only <img>  — только палитра (обои уже ставит вызывающий)
set -euo pipefail

colors_only=0
if [[ "${1:-}" == "--colors-only" ]]; then
    colors_only=1
    shift
fi

if [[ $# -lt 1 ]]; then
    echo "usage: wall-colors [--colors-only] <image>" >&2
    exit 1
fi

img="$1"
[[ -f "$img" ]] || { echo "нет файла: $img" >&2; exit 1; }

if ! command -v matugen >/dev/null 2>&1; then
    echo "matugen не установлен — yay -S matugen-bin" >&2
    exit 1
fi

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wall-colors"
mkdir -p "$state_dir"
printf '%s\n' "$img" > "$state_dir/last"

# 1. Обои (пропускаем, если вызвано с --colors-only)
if (( colors_only == 0 )); then
    awww img "$img" 2>/dev/null || true
fi

# 2. Палитра (M3). Тип и приоритет цвета можно переопределить из окружения,
#    не редактируя файл:
#      PALETTE_TYPE=scheme-vibrant PALETTE_PREFER=saturation wall-random
#    Дефолты — связка, проверенная на текущей сборке matugen
#    (scheme-fidelity + saturation): акцент максимально насыщенный.
#    Набор допустимых --type/--prefer зависит от версии: смотри
#    `matugen --help`. Неподдерживаемое значение валит matugen — тогда
#    переменную просто не задавай.
# </dev/null: matugen 4.x со stdin-TTY уходит в интерактивный выбор цвета и
# падает с "not a terminal", если stdout/stderr перенаправлены.
palette_type="${PALETTE_TYPE:-scheme-fidelity}"
palette_prefer="${PALETTE_PREFER:-saturation}"
if ! matugen_out=$(matugen image "$img" --mode dark --type "$palette_type" --prefer "$palette_prefer" </dev/null 2>&1); then
    echo "$matugen_out" >&2
    echo "matugen упал — см. ошибку выше" >&2
    echo "если ругается на --type/--prefer: сбрось PALETTE_TYPE/PALETTE_PREFER и сверься с matugen --help" >&2
    exit 1
fi

# 3. Reload целей, которые умеют перечитывать конфиг на лету
makoctl reload 2>/dev/null || true
pkill -SIGUSR1 -x kitty 2>/dev/null || true

# 4. Композитор: Hyprland читает colors.lua, Mango — colors.conf.
#    Не важно, какая сессия запущена: сработает доступный IPC.
reload_wm() {
    if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    elif command -v mmsg >/dev/null 2>&1; then
        mmsg dispatch reload_config >/dev/null 2>&1 || true
    fi
}
reload_wm
