#!/usr/bin/env bash
# Шпаргалка по хоткеям системы (Mango).
# Открывается по Super+/ или через Hub. Выводит список в fuzzel -d.

LIST=$(cat <<'EOF'
Super + Return               Терминал (Kitty)
Super + T                  󰭹  Telegram
Super + D                  󰀻  Меню приложений (Fuzzel)
Super + E                    Файловый менеджер (Nautilus)
Super + Q                    Закрыть активное окно
Super + X                  󱗼  Центр управления (Hub)
Super + M                  󰝚  Меню музыки и медиа
Super + Shift + W          󰤨  Меню сетей Wi-Fi
Super + B                  󰂯  Меню устройств Bluetooth
Super + Shift + A          󰕾  Меню звука и микрофонов
Super + Shift + M          󰍬  Запись микрофона
Super + Alt + R            󰕧  Запись экрана
Super + Escape             󰐥  Меню питания и сессии
Super + Shift + V          󰅍  История буфера (Cliphist)
Super + Shift + Q          󰗼  Выход из системы
Super + L                    Блокировка экрана (Hyprlock)
Super + V                    Плавающий / плиточный режим (Float)
Super + /                  ⌨  Шпаргалка по хоткеям
Super + A                  󰸉  Случайные обои
Super + W                  󰸉  Выбор обоев
Super + F                  󰊓  Развернуть окно (Maximized)
Super + Shift + F          󰊓  Полный экран (Fullscreen)
Super + C                  󰆢  Центрировать активное окно
Super + R                  󰕰  Переключить разделение (Dwindle Split)
Super + Tab                󱂬  Сменить раскладку окон (Layout)
Super + Space              󰌌  Переключение раскладки
Super + Стрелки            󰁌  Фокус окна (Влево/Вправо/Вверх/Вниз)
Super + Shift + Стрелки    󰁌  Переместить окно в направлении
Super + Ctrl + Стрелки     󰁌  Изменить размер окна (Resize)
Super + Alt + Ctrl + Стр   󰁌  Точный пиксельный ресайз
Super + Ctrl + Shift + Стр 󰁌  Поменять окна местами (Swap)
Super + ЛКМ / ПКМ          󰆾  Перетаскивание и ресайз мышью
Super + G                  󰓩  Создать / войти в группу окон (Табы)
Super + Alt + G            󰓩  Вынуть окно из группы
Super + Alt + Left/Right   󰓩  Переключение вкладок в группе
Super + Alt + Shift + Стр  󰓩  Закинуть окно в группу
Super + Alt + L            󰓩  Показать / скрыть панель групп
Super + S                  󱂬  Показать / скрыть Scratchpad
Super + Shift + S          󱂬  Отправить окно в Scratchpad
Super + 1..9               󰎤  Перейти на рабочий стол 1..9
Super + Shift + 1..9       󰎤  Перенести окно на рабочий стол 1..9
Super + PageUp / PageDown  󰎤  Соседний рабочий стол
Super + Колесо мыши        󰎤  Соседний рабочий стол
Super + N                  󰂚  Показать скрытые уведомления
Super + Shift + N          󰂛  Закрыть все уведомления
Super + Shift + R          󰑐  Перезагрузить конфиг WM
Super + Shift + P          󰖂  Включить / выключить Proxy
Ctrl + Shift + S             Скриншот выделенной области
Ctrl + Print                 Скриншот всего экрана
Alt + Print                  Скриншот активного окна
XF86 Play / Pause          󰐊  Воспроизведение / Пауза
XF86 Next / Prev           󰒭  Следующий / Предыдущий трек
XF86 Volume Up / Down      󰕾  Громкость звука +5% / -5%
XF86 Mute / MicMute        󰝟  Выключить звук / микрофон
EOF
)

printf '%s\n' "$LIST" | fuzzel -d -p "⌨ Хоткеи ❯ " -w 58 -l 28
