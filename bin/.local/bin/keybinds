#!/usr/bin/env bash
# Шпаргалка по хоткеям: Hyprland (binds.lua) или Mango (config.conf),
# открывается по Super+/. Выводит список в fuzzel -d.

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/binds.lua"
MANGO_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mango/config.conf"

# В сессии Mango читаем его конфиг; XDG_CURRENT_DESKTOP = "mango".
USE_MANGO=0
if [[ "${XDG_CURRENT_DESKTOP:-}" == *mango* || -n "${MANGO_INSTANCE_SIGNATURE:-}" ]]; then
    USE_MANGO=1
fi

# Имя модификатора берём из конфига (local mainMod = "SUPER"), по умолчанию Super
MOD_DISPLAY="Super"
if [[ -r "$CONFIG" ]]; then
    MOD=$(grep -oE 'local mainMod *= *"[^"]+"' "$CONFIG" \
        | head -n1 | sed -E 's/.*"([^"]+)".*/\1/')
    if [[ -n "$MOD" ]]; then
        MOD_DISPLAY=$(printf '%s' "$MOD" | tr '[:upper:]' '[:lower:]' | sed -E 's/^./\U&/')
    fi
fi

# Hyprland: первый аргумент hl.bind(...); Mango: bind=/axisbind=/mousebind=.
#   mainMod .. " + N"          -> Super+N
#   mainMod .. " + " .. i      -> Super+1..9   (цикл for i = 1, 9)
#   "CTRL + SHIFT + code:39"   -> Ctrl+Shift+code:39
#   SUPER+SHIFT,1,tag,1        -> Super+Shift+1
LIST=$(
    if (( USE_MANGO )); then
        if [[ -r "$MANGO_CONFIG" ]]; then
            sed -nE 's/^[[:space:]]*(bind[a-z]*|axisbind|mousebind)=([^,]+),([^,]+),.*/\2+\3/p' "$MANGO_CONFIG" \
                | sed -E \
                    -e 's/\bSUPER\b/Super/g' \
                    -e 's/\bSHIFT\b/Shift/g' \
                    -e 's/\bCTRL\b/Ctrl/g' \
                    -e 's/\bALT\b/Alt/g' \
                    -e 's/\bNONE\+//g' \
                    -e 's/\bNONE\b//g' \
                    -e 's/\bRETURN\b/Enter/g' \
                    -e 's/code:61/\//g' \
                    -e 's/code:39/S/g' \
                    -e 's/Page_Up/PageUp/g' \
                    -e 's/Page_Down/PageDown/g' \
                    -e 's/\bUP\b/WheelUp/g' \
                    -e 's/\bDOWN\b/WheelDown/g' \
                    -e 's/btn_left/MouseLeft/g' \
                    -e 's/btn_right/MouseRight/g' \
                    -e 's/btn_middle/MouseMiddle/g' \
                    -e 's/^[[:space:]]+//' \
                    -e 's/[[:space:]]+$//' \
                | awk 'NF && !seen[$0]++'
        fi
    elif [[ -r "$CONFIG" ]]; then
        sed -nE 's/.*hl\.bind\(([^,]+),.*/\1/p' "$CONFIG" \
            | sed -E \
                -e "s/mainMod \.\. /$MOD_DISPLAY/" \
                -e 's/ \+ /+/g' \
                -e 's/"//g' \
                -e 's/\+[[:space:]]*\.\.[[:space:]]*i/+1..9/' \
                -e 's/\bSUPER\b/Super/g' \
                -e 's/\bSHIFT\b/Shift/g' \
                -e 's/\bCTRL\b/Ctrl/g' \
                -e 's/\bALT\b/Alt/g' \
                -e 's/code:61/\//g' \
                -e 's/code:39/S/g' \
                -e 's/Page_Up/PageUp/g' \
                -e 's/Page_Down/PageDown/g' \
                -e 's/mouse_up/WheelUp/g' \
                -e 's/mouse_down/WheelDown/g' \
                -e 's/mouse:272/LMB/g' \
                -e 's/mouse:273/RMB/g' \
                -e 's/^[[:space:]]+//' \
                -e 's/[[:space:]]+$//' \
            | awk 'NF && !seen[$0]++'
    fi
)

# Фолбэк, если конфиг не найден или пуст
if [[ -z "$LIST" ]]; then
    LIST=$(
        cat <<'EOF'
Super+ENTER        — Kitty
Super+D            — Fuzzel
Super+E            — Nautilus
Super+Q            — закрыть окно
Super+V            — плавающее/плиточное
Super+P            — pseudo-tile
Super+N            — вернуть уведомления
Super+SHIFT+N      — закрыть все уведомления
Super+SHIFT+V      — история буфера (cliphist)
Super+L            — hyprlock
Super+SHIFT+Q      — выход из сессии
Super+A            — случайные обои
Super+W            — выбор обоев
Super+F            — maximized
Super+SHIFT+F      — fullscreen
Super+C            — центр окна
Super+R            — togglesplit
Super+G            — группа окон (табы)
Super+ALT+Left     — предыдущее окно в группе
Super+ALT+Right    — следующее окно в группе
Super+ALT+SHIFT+*  — окно в группу
Super+ALT+L        — заморозить группу
Super+CTRL+*       — ресайз окна
Super+ALT+CTRL+*   — пиксельный ресайз floating
Super+CTRL+SHIFT+* — swap окон
Super+S            — scratchpad
Super+SHIFT+S      — окно в scratchpad
Super+SHIFT+R      — reload конфига
Super+SHIFT+P      — прокси вкл/выкл
Super+1..9         — воркспейс
Super+SHIFT+1..9   — окно на воркспейс
Super+PageUp       — соседний воркспейс
Super+PageDown     — соседний воркспейс
Super+WheelUp      — соседний воркспейс
Super+WheelDown    — соседний воркспейс
Ctrl+Shift+S       — скриншот области
Ctrl+Print         — скриншот экрана
Alt+Print          — скриншот окна
EOF
    )
fi

printf '%s\n' "$LIST" | fuzzel -d -p "⌨ Хоткеи ❯ " -w 55 -l 30
