#!/usr/bin/env bash
# Упаковка темы Telegram Desktop под Material You из текущей палитры обоев.
set -euo pipefail

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wall-colors"
colors_file="$state_dir/colors.tdesktop"
theme_file="$state_dir/Material-You.tdesktop-theme"
last_wall_file="$state_dir/last"

open_theme=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --open)
            open_theme=1
            shift
            ;;
        -h|--help)
            echo "Использование: $(basename "$0") [--open]"
            exit 0
            ;;
        *)
            echo "Неизвестный аргумент: $1" >&2
            echo "Использование: $(basename "$0") [--open]" >&2
            exit 1
            ;;
    esac
done

if [[ ! -f "$colors_file" ]]; then
    echo "Палитра Telegram не найдена: $colors_file" >&2
    echo "Сначала сгенерируй палитру через wall-colors или matugen." >&2
    exit 1
fi

mkdir -p "$state_dir"

# Telegram Desktop ожидает .tdesktop-theme архив, внутри которого строго:
# 1) colors.tdesktop-theme (текстовый файл с палитрой цветов)
# 2) background.jpg (фоновое изображение чата)
# Без background.jpg Telegram считает архив повреждённым (Bad theme content size: 0)
# и откатывается на дефолтную классическую светлую тему с зелёным фоном.
# Чтобы не перекрывать чат обоями рабочего стола, генерируем сплошной тёмный фон цвета windowBg.
python3 - <<EOF
import os, re, zipfile
from PIL import Image

colors_file = "$colors_file"
theme_file = "$theme_file"
state_dir = "$state_dir"
tdesktop_theme_file = os.path.join(state_dir, "colors.tdesktop-theme")
bg_file = os.path.join(state_dir, "background.jpg")

bg_color = "#18120f"
if os.path.exists(colors_file):
    with open(colors_file, "r", encoding="utf-8") as f:
        for line in f:
            m = re.match(r"^windowBg:\s*(#[0-9a-fA-F]{6});", line)
            if m:
                bg_color = m.group(1)
                break

# Генерируем сплошной фоновый тайл цвета windowBg (без растягивания обоев)
img = Image.new("RGB", (64, 64), color=bg_color)
img.save(bg_file, "JPEG", quality=95)

# Копируем палитру с именем colors.tdesktop-theme
with open(colors_file, "r", encoding="utf-8") as src, open(tdesktop_theme_file, "w", encoding="utf-8") as dst:
    dst.write(src.read())

# Собираем валидный zip-архив .tdesktop-theme
with zipfile.ZipFile(theme_file, "w", compression=zipfile.ZIP_DEFLATED) as z:
    z.write(tdesktop_theme_file, arcname="colors.tdesktop-theme")
    z.write(bg_file, arcname="background.jpg")

if os.path.exists(bg_file):
    os.remove(bg_file)
EOF

# Уведомление отправляем ТОЛЬКО при явном вызове с --open или если запущено вручную,
# чтобы не дублировать уведомление о смене обоев из wall-picker / wall-random.
if (( open_theme == 1 )); then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Telegram" "(o_o) Тема Telegram" "Открываю окно применения темы..." 2>/dev/null || true
    fi

    if [[ -x /usr/bin/Telegram ]]; then
        /usr/bin/Telegram "$theme_file" >/dev/null 2>&1 &
    elif command -v telegram-desktop >/dev/null 2>&1; then
        telegram-desktop "$theme_file" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$theme_file" >/dev/null 2>&1 || true
    fi
fi

echo "Тема Telegram упакована: $theme_file"
