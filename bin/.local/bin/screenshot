#!/usr/bin/env bash
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

case "$1" in
    area)
        GEOM=$(slurp) || exit 0
        grim -g "$GEOM" "$FILE" && wl-copy < "$FILE" && notify-send -i "$FILE" -a "Скриншот" "(^_^)b Скриншот области" "Сохранено в буфер и $DIR"
        ;;
    window)
        BOX=""
        if command -v hyprctl >/dev/null 2>&1 && hyprctl activeworkspace >/dev/null 2>&1; then
            BOX=$(hyprctl -j activewindow 2>/dev/null | jq -r 'if .at and .size then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end' 2>/dev/null || true)
            [[ "$BOX" == "null" ]] && BOX=""
        fi
        if [[ -z "$BOX" ]]; then
            GEOM=$(slurp) || exit 0
            grim -g "$GEOM" "$FILE" && wl-copy < "$FILE" && notify-send -i "$FILE" -a "Скриншот" "(^_^)b Скриншот области" "Сохранено в буфер и $DIR"
        else
            grim -g "$BOX" "$FILE" && wl-copy < "$FILE" && notify-send -i "$FILE" -a "Скриншот" "(^_^)b Скриншот окна" "Сохранено в буфер и $DIR"
        fi
        ;;
    full|*)
        grim "$FILE" && wl-copy < "$FILE" && notify-send -i "$FILE" -a "Скриншот" "(^_^)b Скриншот экрана" "Сохранено в буфер и $DIR"
        ;;
esac
