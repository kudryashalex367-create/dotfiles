{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ❯ ",
        "color": {
            "keys": "#a78bfa",
            "title": "#c4b5fd"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS       "
        },
        {
            "type": "kernel",
            "key": "Kernel   "
        },
        {
            "type": "wm",
            "key": "WM       "
        },
        {
            "type": "shell",
            "key": "Shell    "
        },
        {
            "type": "terminal",
            "key": "Terminal "
        },
        {
            "type": "uptime",
            "key": "Uptime   "
        },
        "break",
        "colors"
    ]
}
