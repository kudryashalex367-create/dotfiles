// Telegram Desktop Material You Dark Theme
// Сгенерировано через Matugen из обоев

// Базовые окна и диалоги
windowBg: {{colors.surface.default.hex}};
windowFg: {{colors.on_surface.default.hex}};
windowBgOver: {{colors.surface_container_high.default.hex}};
windowBgActive: {{colors.primary.default.hex}};
windowFgActive: {{colors.on_primary.default.hex}};
windowActiveTextFg: {{colors.primary.default.hex}};
windowSubTextFg: {{colors.outline.default.hex}};
windowSubTextFgOver: {{colors.on_surface_variant.default.hex}};
windowBoldFg: {{colors.on_surface.default.hex}};
windowBoldFgOver: {{colors.on_surface.default.hex}};
windowShadowFg: #00000040;

// Верхняя панель (Header / Title bar)
titleBg: {{colors.surface.default.hex}};
titleShadow: transparent;
titleButtonBg: transparent;
titleButtonFg: {{colors.on_surface.default.hex}};
titleButtonBgOver: {{colors.surface_container.default.hex}};
titleButtonFgOver: {{colors.on_surface.default.hex}};
titleButtonBgActive: {{colors.primary.default.hex}};
titleButtonFgActive: {{colors.on_primary.default.hex}};

// Кнопки
lightButtonBg: {{colors.primary.default.hex}};
lightButtonFg: {{colors.on_primary.default.hex}};
lightButtonBgOver: {{colors.primary_container.default.hex}};
lightButtonFgOver: {{colors.on_primary_container.default.hex}};
activeButtonBg: {{colors.primary.default.hex}};
activeButtonFg: {{colors.on_primary.default.hex}};
activeButtonBgOver: {{colors.primary_container.default.hex}};
activeButtonFgOver: {{colors.on_primary_container.default.hex}};
activeLineTitle: {{colors.primary.default.hex}};
activeLineTitleActive: {{colors.primary.default.hex}};

// Список чатов (боковая панель)
dialogsBg: {{colors.surface_container_low.default.hex}};
dialogsBgOver: {{colors.surface_container.default.hex}};
dialogsBgActive: {{colors.primary_container.default.hex}};
dialogsNameFg: {{colors.on_surface.default.hex}};
dialogsNameFgOver: {{colors.on_surface.default.hex}};
dialogsNameFgActive: {{colors.on_primary_container.default.hex}};
dialogsTextFg: {{colors.outline.default.hex}};
dialogsTextFgOver: {{colors.on_surface_variant.default.hex}};
dialogsTextFgActive: {{colors.on_primary_container.default.hex}};
dialogsDateFg: {{colors.outline.default.hex}};
dialogsDateFgOver: {{colors.outline.default.hex}};
dialogsDateFgActive: {{colors.on_primary_container.default.hex}};
dialogsUnreadBg: {{colors.primary.default.hex}};
dialogsUnreadFg: {{colors.on_primary.default.hex}};
dialogsUnreadBgMuted: {{colors.surface_container_highest.default.hex}};
dialogsUnreadFgMuted: {{colors.outline.default.hex}};
dialogsUnreadBgMutedActive: {{colors.surface_container_highest.default.hex}};
dialogsUnreadFgMutedActive: {{colors.on_surface.default.hex}};
dialogsDraftFg: {{colors.primary.default.hex}};
dialogsVerifiedIconBg: {{colors.primary.default.hex}};
dialogsVerifiedIconFg: {{colors.on_primary.default.hex}};

// Сообщения и чат
historyTextInFg: {{colors.on_surface.default.hex}};
historyTextOutFg: #ffffff;
msgInBg: {{colors.surface_container.default.hex}};
msgInBgSelected: {{colors.surface_container_high.default.hex}};
msgOutBg: {{colors.primary.default.hex}};
msgOutBgSelected: {{colors.primary_container.default.hex}};
msgInDateFg: {{colors.outline.default.hex}};
msgOutDateFg: #ffffffc0;
msgInDateFgSelected: {{colors.outline.default.hex}};
msgOutDateFgSelected: #ffffffff;
msgInServiceFg: {{colors.on_surface_variant.default.hex}};
msgOutServiceFg: #ffffffc0;

// Имена и ссылки в сообщениях
historyFileNameInFg: {{colors.primary.default.hex}};
historyFileNameOutFg: #ffffff;
historyLinkInFg: {{colors.primary.default.hex}};
historyLinkOutFg: #ffffff;
historyPeer1NameFg: {{colors.primary.default.hex}};
historyPeerUserFg: {{colors.primary.default.hex}};

// Сервисные сообщения (системные плашки в центре)
msgServiceBg: {{colors.surface_container_highest.default.hex}}a0;
msgServiceFg: {{colors.on_surface.default.hex}};

// Поле ввода сообщения
historyComposeAreaBg: {{colors.surface.default.hex}};
historyComposeAreaFg: {{colors.on_surface.default.hex}};
historyComposeField: {{colors.surface_container.default.hex}};
historyComposeFieldPlaceholder: {{colors.outline.default.hex}};
historySendIcon: {{colors.primary.default.hex}};
historySendIconOver: {{colors.primary_container.default.hex}};

// Всплывающие меню и списки
menuBg: {{colors.surface_container_high.default.hex}};
menuBgOver: {{colors.surface_container_highest.default.hex}};
menuFg: {{colors.on_surface.default.hex}};
menuIconFg: {{colors.primary.default.hex}};
menuIconFgOver: {{colors.primary.default.hex}};
