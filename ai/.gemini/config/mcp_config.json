{
  "mcpServers": {
    "git": {
      "command": "sh",
      "args": [
        "-c",
        "exec uvx mcp-server-git --repository \"$HOME/dotfiles\""
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "horizon": {
      "command": "horizon-launcher",
      "args": [
        "mcp"
      ]
    }
  }
}

