{
  "mcpServers": {
    "git": {
      "command": "sh",
      "args": [
        "-c",
        "exec uvx mcp-server-git --repository \"$HOME/dotfiles\""
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "horizon": {
      "command": "horizon-launcher",
      "args": [
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ]
    },
    "computer-use": {
      "command": "/home/zev1ce/.local/bin/computer-use-linux",
      "args": [
        "mcp"
      ]
    }
  }
}

