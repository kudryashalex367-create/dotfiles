{
  "$schema": "https://opencode.ai/config.json",
  "model": "aitunnel/deepseek-v4.1-flash-1017",
  "small_model": "aitunnel/deepseek-v4.1-flash-1017",
  "update": "disable",
  "share": "disabled",
  "provider": {
    "aitunnel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AITunnel",
      "options": {
        "baseURL": "https://api.aitunnel.ru/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.zshrc_secrets": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "**/*secret*": "deny",
      "**/*token*": "deny",
      "**/*credential*": "deny",
      "**/*password*": "deny",
      "**/*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git branch*": "allow",
      "hyprctl configerrors*": "allow",
      "makoctl reload*": "allow",
      "zsh -n *": "allow",
      "bash -n *": "allow",
      "shellcheck *": "allow",
      "jq *": "allow",
      "stow *": "allow",
      "./install.sh": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git add -A*": "deny",
      "git add .": "deny",
      "git add -f*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git stash*": "deny",
      "git checkout -f*": "deny",
      "sudo *": "deny",
      "pacman *": "deny",
      "yay *": "deny",
      "systemctl *": "deny",
      "chsh *": "deny",
      "rm -rf *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "env": "deny",
      "printenv*": "deny"
    }
  }
}
