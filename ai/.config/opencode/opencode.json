{
  "$schema": "https://opencode.ai/config.json",
  "model": "aitunnel/deepseek-v4.1-flash-1017",
  "small_model": "aitunnel/deepseek-v4.1-flash-1017",
  "update": "disable",
  "share": "disabled",
  "provider": {
    "aitunnel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AITunnel",
      "options": {
        "baseURL": "https://api.aitunnel.ru/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
  "*": "allow",
  "read": {
    "*": "allow",
    "*.env": "deny",
    "*.env.*": "deny",
    "**/.zshrc_secrets": "deny",
    "**/.ssh/**": "deny",
    "**/.gnupg/**": "deny"
  },
  "edit": "allow",
  "bash": {
    "*": "allow",
    "sudo *": "deny",
    "pacman *": "deny",
    "yay *": "deny"
  },
  "webfetch": "allow",
  "websearch": "allow",
  "external_directory": "allow",
  "doom_loop": "allow"
}