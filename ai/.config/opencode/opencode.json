{
  "$schema": "https://opencode.ai/config.json",
  "model": "aitunnel/deepseek-v4.1-flash-1017",
  "small_model": "aitunnel/deepseek-v4.1-flash-1017",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "aitunnel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AITunnel",
      "options": {
        "baseURL": "https://api.aitunnel.ru/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "{env:HOME}/dotfiles"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "horizon": {
      "type": "local",
      "command": [
        "horizon-launcher",
        "mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ]
    },
    "computer-use": {
      "type": "local",
      "command": [
        "/home/zev1ce/.local/bin/computer-use-linux",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.zshrc_secrets": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pacman *": "deny",
      "yay *": "deny",
      "paru *": "deny",
      "chsh *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git add -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git checkout -f*": "deny",
      "systemctl *": "deny",
      "systemctl --user *": "allow",
      "*zshrc_secrets*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "git push*": "ask",
      "git add .": "ask",
      "git add -A*": "ask",
      "git add --all*": "ask",
      "git stash*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "rm -rf *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  }
}
