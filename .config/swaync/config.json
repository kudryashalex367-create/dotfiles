{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 380,
  "control-center-height": 680,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-service": true,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,

  "widget-config": {
    "title": {
      "text": "21:09  ·  Воскресенье, 16 авг",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "buttons-grid#clock": {
      "actions": [
        {
          "label": "  --:--",
          "update-command": "date +'%H:%M   ·   %A, %d %B'",
          "command": ""
        }
      ]
    },
    "dnd": {
      "text": "21:09  ·  Воскресенье, 16 авг"
    },
    "mpris": {
      "image-size": 68,
      "image-radius": 12
    },
    "volume": {
      "label": " ",
      "show-per-app": true,
      "show-per-app-icon": true
    },
    "backlight": {
      "label": " ",
      "device": "amdgpu_bl1",
      "sub-device": "amdgpu_bl0"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "  Mute Audio",
          "type": "toggle",
          "active": false,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        },
        {
          "label": "  Mute Mic",
          "type": "toggle",
          "active": false,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        {
          "label": "  Wi-Fi",
          "command": "kitty --class float_kitty -e nmtui"
        },
        {
          "label": "  Bluetooth",
          "command": "kitty --class float_kitty -e bluetoothctl"
        },
        {
          "label": "  Screenshot",
          "command": "swaync-client -t -sw && niri msg action screenshot"
        },
        {
          "label": "  Lock",
          "command": "swaync-client -t -sw && niri msg action switch-layout 0 && hyprlock"
        }
      ]
    }
  },

  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "dnd",
    "notifications"
  ]
}
