environment {
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    http_proxy "http://127.0.0.1:12334"
    https_proxy "http://127.0.0.1:12334"
    all_proxy "socks5://127.0.0.1:12334"
    HTTP_PROXY "http://127.0.0.1:12334"
    HTTPS_PROXY "http://127.0.0.1:12334"
    ALL_PROXY "socks5://127.0.0.1:12334"
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

output "DP-2" {
    mode "1920x1080@144.000"
}
output "HDMI-A-1" {
    mode "1920x1080@144.000"
}
output "eDP-1" {
    mode "1920x1080@144.000"
}

blur {
    passes 3
    offset 4.2
    noise 0.015
    saturation 1.20
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }
    mouse {
        accel-speed -0.4
    }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 10
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        width 2
        active-color "#ffffff"
        inactive-color "#27272a"
    }
    struts {
        top 0
        bottom 0
        left 0
        right 0
    }
}

animations {
    slowdown 1.2

    workspace-switch {
        spring damping-ratio=1.0 stiffness=480 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=460 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=480 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.02 stiffness=420 epsilon=0.0001
    }
    window-open {
        duration-ms 170
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 130
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=480 epsilon=0.0001
    }
    screenshot-ui-open {
        duration-ms 160
        curve "ease-out-cubic"
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    background-effect {
        blur true
        xray true
    }
}

prefer-no-csd

spawn-at-startup "mako"
spawn-at-startup "awww-daemon"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"

spawn-at-startup "gsettings" "set" "org.gnome.system.proxy" "mode" "manual"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.http" "host" "127.0.0.1"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.http" "port" "12334"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.https" "host" "127.0.0.1"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.https" "port" "12334"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.socks" "host" "127.0.0.1"
spawn-at-startup "gsettings" "set" "org.gnome.system.proxy.socks" "port" "12334"
spawn-at-startup "xwayland-satellite"

spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "cursor-theme" "Bibata-Modern-Ice"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "cursor-size" "24"

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

binds {
    // Mod+N — восстановить последнее закрытое уведомление
    Mod+N { spawn "makoctl" "restore"; }
    // Mod+Shift+N — закрыть все уведомления на экране
    Mod+Shift+N { spawn "makoctl" "dismiss" "-a"; }
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+L { spawn "sh" "-c" "niri msg action switch-layout 0 && hyprlock"; }
    Mod+V { spawn "bash" "-c" "cliphist list | fuzzel -d | cliphist decode | wl-copy"; }
    // Случайные обои на Mod+A
    Mod+A { spawn "bash" "-c" "$HOME/.local/bin/wall-random"; }
    Mod+W { spawn "bash" "-c" "$HOME/.local/bin/wall-picker"; }

    Mod+O { toggle-overview; }
    Mod+Slash { show-hotkey-overlay; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Alt+Down { focus-window-down; }
    Mod+Alt+Up   { focus-window-up; }

    Mod+Down { focus-workspace-down; }
    Mod+Up   { focus-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up   { move-column-to-workspace-up; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+Minus { consume-window-into-column; }
    Mod+Equal { expel-window-from-column; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    Ctrl+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
}

window-rule {
    match app-id="^steam$"
    default-column-width { proportion 0.75; }
}

window-rule {
    match title="^Friends List$"
    open-floating true
}

layer-rule {
    match namespace="^(launcher|fuzzel|mako)$"
    background-effect {
        blur true 
        xray false
    }
}
